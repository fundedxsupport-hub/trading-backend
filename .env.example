ENVIRONMENT=development
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=fundedx_trading
CORS_ORIGINS=*
OTP_TTL_SECONDS=300

# Upstox live execution
# Put your real admin/master Upstox credentials only in trading-backend/.env
# Never place these values in fundedx-app or fundedx-admin.
DEMO_BROKER_MODE=true
UPSTOX_BASE_URL=https://api.upstox.com/v2
UPSTOX_ACCESS_TOKEN=
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_PRODUCT=I
UPSTOX_VALIDITY=DAY

# Optional admin API key hook for deployment gateway/middleware
ADMIN_API_KEY=
